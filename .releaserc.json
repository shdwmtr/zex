{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sh scripts/semantic-release-prepare.sh ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["Cargo.toml", "Cargo.lock"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "dist/Zex-macos/Zex-macos.zip", "label": "Zex-macos.zip" },
          { "path": "dist/zex-linux-appimage/*.AppImage", "label": "zex-linux-x86_64.AppImage" }
        ]
      }
    ]
  ]
}
